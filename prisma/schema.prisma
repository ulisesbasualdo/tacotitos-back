generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tortilla {
  id           Int      @id @default(autoincrement())
  nombre       String
  precio       Float
  tipoTortilla String   @default("single") // 'single' | 'double'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relaciones
  tacos        Taco[]
  @@map("tortillas")
}

model Filling {
  id        Int      @id @default(autoincrement())
  nombre    String
  precio    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  tacoFillings TacoFilling[]
  @@map("fillings")
}

model Sauce {
  id        Int      @id @default(autoincrement())
  nombre    String
  precio    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  tacos     Taco[]
  @@map("sauces")
}

model Taco {
  id         Int      @id @default(autoincrement())
  tortillaId Int
  sauceId    Int?     // Opcional porque la salsa puede ser null
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relaciones
  tortilla   Tortilla @relation(fields: [tortillaId], references: [id])
  sauce      Sauce?   @relation(fields: [sauceId], references: [id])
  fillings   TacoFilling[]

  @@map("tacos")
}

model TacoFilling {
  id        Int      @id @default(autoincrement())
  tacoId    Int
  fillingId Int
  createdAt DateTime @default(now())
  
  // Relaciones
  taco      Taco     @relation(fields: [tacoId], references: [id], onDelete: Cascade)
  filling   Filling  @relation(fields: [fillingId], references: [id])
  
  @@unique([tacoId, fillingId])
  @@map("taco_fillings")
}