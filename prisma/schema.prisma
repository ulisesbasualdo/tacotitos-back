generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tortilla {
  id           Int      @id @default(autoincrement())
  name         String
  price        Float
  
  // Relaciones
  tacos        Taco[]
  @@map("tortillas")
}

model Filling {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  
  // Relaciones
  tacoFillings TacoFilling[]
  @@map("fillings")
}

model Sauce {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  
  // Relaciones
  tacos     Taco[]
  @@map("sauces")
}

model Taco {
  id         Int      @id @default(autoincrement())
  tortillaId Int
  sauceId    Int?
  doubleTortilla Boolean
  
  // Relaciones
  tortilla   Tortilla @relation(fields: [tortillaId], references: [id])
  sauce      Sauce?   @relation(fields: [sauceId], references: [id])
  fillings   TacoFilling[]

  @@map("tacos")
}

model TacoFilling {
  id        Int      @id @default(autoincrement())
  tacoId    Int
  fillingId Int
  
  // Relaciones
  taco      Taco     @relation(fields: [tacoId], references: [id], onDelete: Cascade)
  filling   Filling  @relation(fields: [fillingId], references: [id])
  
  @@unique([tacoId, fillingId])
  @@map("taco_fillings")
}

model Customer {
  id Int  @id @default(autoincrement())
  name String
  cellphone String

  //Relaciones
  orders Order[]
}

model Delivery {
  id Int @id @default(autoincrement())
  patent String
  name String
  cellphone String
  state String

  //relaciones
  orders Order[]
}

model Order {
  id Int @id @default(autoincrement())
  datetime DateTime
  price Float
  isDelivered Boolean

  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])
  deliveryId Int
  delivery Delivery @relation(fields: [deliveryId], references: [id])
}